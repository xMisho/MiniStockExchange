DB_URL=jdbc:postgresql://localhost:5432/mini_stock_exchange
DB_TEST_URL=jdbc:postgresql://localhost:5432/mini_stock_exchange_test
DB_USERNAME=mini_stock_exchange
DB_PASSWORD=replace-with-your-local-password

ALPACA_API_KEY=
ALPACA_API_SECRET=

# Hosted settings belong in Render's Environment tab, not in Git.
# DB_URL=jdbc:postgresql://your-neon-host/neondb?sslmode=require&channelBinding=require
# DB_USERNAME=your-neon-role
# SESSION_COOKIE_SECURE=true

# Transactional email (optional). Never commit real keys.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# Public frontend URL used to construct trusted recovery links; HTTPS when hosted.
APP_PUBLIC_URL=http://localhost:5173
# Generate once: openssl rand -base64 32. Keep stable across restarts/deployments.
EMAIL_ENCRYPTION_KEY=
# Set to your own inbox while using Resend's restricted test sender.
EMAIL_ALLOWED_RECIPIENT=
